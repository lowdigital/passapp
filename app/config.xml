<?xml version='1.0' encoding='utf-8'?>
<widget id="com.example.passapp" version="2.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Passapp</name>
    <description>Secure password manager with client-side encryption</description>
    <author email="your-email@example.com" href="https://example.com">
        Your Name
    </author>
    
    <content src="index.html" />
    
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="#0f172a" />
    <preference name="StatusBarBackgroundColor" value="#0f172a" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <preference name="AndroidLaunchMode" value="singleTask" />
    
    <platform name="android">
        <preference name="loadUrlTimeoutValue" value="700000" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        
        <icon src="res/android/ldpi.png" density="ldpi" />
        <icon src="res/android/mdpi.png" density="mdpi" />
        <icon src="res/android/hdpi.png" density="hdpi" />
        <icon src="res/android/xhdpi.png" density="xhdpi" />
        <icon src="res/android/xxhdpi.png" density="xxhdpi" />
        <icon src="res/android/xxxhdpi.png" density="xxxhdpi" />
        
        <splash src="res/android/splash.png" density="port-xxhdpi" />
    </platform>
    
    <platform name="ios">
        <preference name="deployment-target" value="12.0" />
        <preference name="WKWebViewOnly" value="true" />
    </platform>
</widget>

